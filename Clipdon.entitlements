<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      App Sandbox is mandatory for the Mac App Store.
      Clipdon needs NO other entitlements:
        - Reading NSPasteboard is allowed inside the sandbox.
        - RegisterEventHotKey (⌘⇧V) works inside the sandbox.
        - SMAppService login item works inside the sandbox.
        - history.json is written to the app's own container.
    -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
