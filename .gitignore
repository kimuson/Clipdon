# ─── Build artifacts ───────────────────────────────────────────
.build/
.swiftpm/
build/
DerivedData/
*.app/
*.xcarchive
*.pkg
*.dmg
Clipdon.zip

# Generated by XcodeGen (source of truth is project.yml)
*.xcodeproj

# Xcode user-specific state
xcuserdata/
*.xcuserstate

# Generated preview asset
icon-preview.png

# ─── Signing material & secrets (NEVER commit) ─────────────────
# Certificates / private keys
*.p12
*.pfx
*.pem
*.key
*.cer
*.der
*.certSigningRequest
-----BEGIN*
# Provisioning profiles
*.mobileprovision
*.provisionprofile
# App Store Connect API keys
AuthKey_*.p8
# Keychains
*.keychain
*.keychain-db
# Environment / credential files
.env
.env.*
secrets.*
*.secret
*.secrets
credentials.json

# ─── Local app data (in case it's ever copied into the repo) ────
history.json
favorites.json

# ─── macOS / misc ──────────────────────────────────────────────
.DS_Store
**/.DS_Store
*.log
